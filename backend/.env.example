# ==================================================
# CEPHALOAI BACKEND - ENVIRONMENT CONFIGURATION
# ==================================================

# --- DATABASE ---
DATABASE_URL=sqlite:///./ceph.db

# --- SECURITY ---
# Generate a secure key using: openssl rand -hex 32
SECRET_KEY=your_secure_random_hex_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- EMAIL SMTP (GMAIL EXAMPLE) ---
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_16_digit_app_password_here

# --- AUTH & ACCESS ---
MASTER_EMAILS=admin1@example.com,admin2@example.com

# --- NETWORKING ---
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
