# ==================================================
# CEPHALOAI FRONTEND - ENVIRONMENT CONFIGURATION
# ==================================================
# Note: All variables must be prefixed with REACT_APP_

# The URL of your FastAPI backend
REACT_APP_API_URL=http://localhost:8000

# Comma-separated list of admin emails authorized for global management
REACT_APP_MASTER_EMAILS=admin1@example.com,admin2@example.com
